 server/jest.config.js                       |   5 +
 server/package-lock.json                    | 435 +++++++++++++++++++-
 server/package.json                         |   1 +
 server/src/controllers/projectController.js |   7 +-
 server/src/controllers/taskController.js    |  49 ++-
 server/src/middleware/auth.js               |  28 ++
 server/src/models/Project.js                |   6 +
 server/src/routes/projectRoutes.js          |   3 +
 server/src/routes/taskRoutes.js             |   3 +
 server/tests/auth.test.js                   |  49 +++
 server/tests/project.test.js                |  87 ++++
 server/tests/setup.js                       |  44 ++
 13 files changed, 713 insertions(+), 17 deletions(-)
 create mode 100644 server/jest.config.js
 create mode 100644 server/src/middleware/auth.js
 create mode 100644 server/tests/auth.test.js
 create mode 100644 server/tests/project.test.js
 create mode 100644 server/tests/setup.js

diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
index c4f2656..42d5d00 100644
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -10,6 +10,16 @@ jobs:
   ci:
     name: Continuous Integration
     runs-on: ubuntu-latest
+    services:
+      mongo:
+        image: mongo:7
+        ports:
+          - 27017:27017
+        options: >-
+          --health-cmd "echo 'db.runCommand(\"ping\").ok' | mongosh localhost:27017/test --quiet"
+          --health-interval 10s
+          --health-timeout 5s
+          --health-retries 5
 
     steps:
       - name: Checkout code
@@ -27,6 +37,9 @@ jobs:
       - name: Run backend tests
         working-directory: server
         run: npm test
+        env:
+          TEST_MONGO_URI: mongodb://localhost:27017/devflow-test
+          JWT_SECRET: ci_test_secret
 
       - name: Install frontend dependencies
         working-directory: client
